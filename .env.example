# =============================================================================
# デモ用の初期値です。本番・機密ネットワークでは必ず変更してください。
# インターネット到達を前提にしません（エアギャップ可）。
# =============================================================================

COMPOSE_PROJECT_NAME=ugv-mlops
# 拡張（LakeFS / Gitea / Grafana / Prometheus / Redis）を常時起動するなら:
# COMPOSE_PROFILES=full

POSTGRES_USER=ugv
POSTGRES_PASSWORD=ugv_change_me
POSTGRES_DB=postgres

MINIO_ROOT_USER=GKabcdef0123456789abcdef01234567
MINIO_ROOT_PASSWORD=ugv_garage_secret_change_me_do_not_use_in_prod
MINIO_BUCKET_RAW=raw
MINIO_BUCKET_CURATED=curated
MINIO_BUCKET_DATASETS=datasets
MINIO_BUCKET_MODELS=models
MINIO_BUCKET_PACKAGES=packages
MINIO_BUCKET_MLFLOW=mlflow
MINIO_BUCKET_LAKEFS=lakefs
MINIO_BUCKET_DVC=dvc
GARAGE_ADMIN_TOKEN=ugv_garage_admin_change_me

MLFLOW_TRACKING_URI=http://mlflow:5000
AWS_ACCESS_KEY_ID=GKabcdef0123456789abcdef01234567
AWS_SECRET_ACCESS_KEY=ugv_garage_secret_change_me_do_not_use_in_prod
AWS_DEFAULT_REGION=garage
MLFLOW_S3_ENDPOINT_URL=http://garage:3900

LAKEFS_AUTH_ENCRYPT_SECRET_KEY=lakefs-encrypt-change-me-32bytes!!
GITEA_SECRET_KEY=gitea-secret-change-me
GITEA_INTERNAL_TOKEN=gitea-internal-change-me

LABEL_STUDIO_USERNAME=admin@ugv.local
LABEL_STUDIO_PASSWORD=label_change_me

LAKEFS_ACCESS_KEY_ID=AKIAUGVLAKEFS01
LAKEFS_SECRET_ACCESS_KEY=lakefs_secret_change_me_32chars!

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_change_me

CATALOG_DATABASE_URL=postgresql+psycopg://ugv:ugv_change_me@postgres:5432/catalog
REDIS_URL=redis://redis:6379/0

# 学習段（S3=前線拠点 / S4=後方フル学習）
DEFAULT_LEARNING_STAGE=S3

# アノテ: SALT / SAM / Xtreme1 は Autoware_e2e 側。Xtreme1 は :8190（Garage :9000 と別）
# Autoware_e2e がある PC では絶対パスに変える。例: C:/Users/<you>/Autoware_e2e
AUTOWARE_E2E_ROOT=./data/autoware_stub
XTREME1_URL=http://127.0.0.1:8190

# AutoE2E（ホスト GPU ワーカーが Autoware_e2e を呼ぶ）
# AUTOE2E_RIG=C:/Users/<you>/Autoware_e2e/config/rosbag2_autoe2e/rig.carla.yaml
# AUTOE2E_PYTHON=
# AUTOE2E_EPOCHS=3
# AUTOE2E_STRIDE=5
# AUTOE2E_ACCUM_STEPS=8
# AUTOE2E_EXTRA_ARGS=

# CARLA（compose 外。準備: scripts/setup-carla.ps1 -Download）
# WSL 例: CARLA_ROOT=/home/<user>/CARLA
# Windows native 例: CARLA_ROOT=C:/CARLA かつ CARLA_LAUNCH_MODE=native
CARLA_ROOT=/home/xeno1/CARLA
CARLA_LAUNCH_MODE=wsl
# CARLA_WSL_DISTRO=
CARLA_HOST=127.0.0.1
CARLA_PORT=2000
CARLA_QUALITY=Low
CARLA_MINING_EXTRA_ARGS=--sync

# 署名鍵（bootstrap が data/keys に生成）
SIGNING_KEY_PATH=/keys/ed25519.pem
SIGNING_PUB_PATH=/keys/ed25519.pub

# ROS2 bag 展開（空の ROSBAG_TOPICS は自動判定）
# ROSBAG_TOPICS=/sensing/camera/front/image_raw
ROSBAG_FRAME_STRIDE=5
ROSBAG_MAX_FRAMES_PER_TOPIC=400
ROSBAG_LIDAR_STRIDE=20
ROSBAG_MAX_LIDAR_KEYFRAMES=80
ROSBAG_MAX_LIDAR_POINTS=80000
E2E_ACTION_MAX_DT_SEC=0.25

# YOLOX-Nano（worker のみ。公式 nano 重みは data/models へ）
YOLOX_WEIGHTS_PATH=/data/models/yolox_nano.pth
YOLOX_CACHE_DIR=/data/cache
YOLOX_IMGSZ=416
YOLOX_TRAIN_STEPS=8
YOLOX_MAX_TRAIN_IMAGES=24
